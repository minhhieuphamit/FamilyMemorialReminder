{
  "name": "family-memorial-reminder",
  "version": "1.0.0",
  "private": true,
  "description": "Quản lý ngày giỗ gia đình theo âm lịch Việt Nam, nhắc qua Telegram, chạy trên Cloudflare Free Plan.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build && concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "wrangler dev --port 8787 --test-scheduled",
    "dev:web": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p frontend/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build && wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply family-memorial-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply family-memorial-db --remote",
    "db:seed:local": "wrangler d1 execute family-memorial-db --local --file=seeds/sample_data.sql",
    "db:seed:remote": "wrangler d1 execute family-memorial-db --remote --file=seeds/sample_data.sql",
    "db:backup": "wrangler d1 export family-memorial-db --remote --output=backup.sql"
  },
  "dependencies": {
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@fontsource/be-vietnam-pro": "^5.2.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "*",
    "concurrently": "^9.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0 || ^7.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
